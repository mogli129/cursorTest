<Window x:Class="SwCheckinConflictButtonAddin.CadPermissionWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:SwCheckinConflictButtonAddin"
        Title="根据冲突CAD文档权限来分配操作"
        Width="1560" Height="640"
        MinWidth="960" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        Background="White"
        Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:HandyControlTheme/>
            </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="ElBorder" Color="#EBEEF5"/>
        <SolidColorBrush x:Key="ElHeaderBg" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="ElHeaderFg" Color="#909399"/>
        <SolidColorBrush x:Key="ElText" Color="#606266"/>
        <SolidColorBrush x:Key="ElHover" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="ElSelected" Color="#ECF5FF"/>
        <SolidColorBrush x:Key="ElPrimary" Color="#409EFF"/>
        <SolidColorBrush x:Key="ElInputBorder" Color="#DCDFE6"/>
        <SolidColorBrush x:Key="ElInputHover" Color="#C0C4CC"/>

        <Style x:Key="ElColumnHeaderGripper" TargetType="Thumb">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PermTagTemplate">
            <Border MinWidth="36" Height="20" CornerRadius="3" Padding="6,0" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F4F4F5"/>
                        <Setter Property="BorderBrush" Value="#E9E9EB"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="有">
                                <Setter Property="Background" Value="#F0F9EB"/>
                                <Setter Property="BorderBrush" Value="#E1F3D8"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="无">
                                <Setter Property="Background" Value="#FEF0F0"/>
                                <Setter Property="BorderBrush" Value="#FDE2E2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#909399"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="有">
                                    <Setter Property="Foreground" Value="#67C23A"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="无">
                                    <Setter Property="Foreground" Value="#F56C6C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <Style x:Key="ElColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource ElHeaderBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ElHeaderFg}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource ElBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                    <Path x:Name="SortArrow"
                                          Grid.Column="1"
                                          Width="8" Height="5"
                                          Stretch="Fill"
                                          Fill="#C0C4CC"
                                          VerticalAlignment="Center"
                                          Margin="6,1,0,0"
                                          Visibility="Collapsed"
                                          Data="M0,0 L7,0 L3.5,5 Z"/>
                                </Grid>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper"
                                   HorizontalAlignment="Left"
                                   Style="{StaticResource ElColumnHeaderGripper}"/>
                            <Thumb x:Name="PART_RightHeaderGripper"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource ElColumnHeaderGripper}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M0,5 L7,5 L3.5,0 Z"/>
                                <Setter TargetName="SortArrow" Property="Fill" Value="#909399"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M0,0 L7,0 L3.5,5 Z"/>
                                <Setter TargetName="SortArrow" Property="Fill" Value="#909399"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ElColumnHeaderCenter" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ElColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ElDataGridCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ElText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                ClipToBounds="False">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource ElText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ElDataGridCellOp" TargetType="DataGridCell" BasedOn="{StaticResource ElDataGridCell}">
            <Setter Property="Padding" Value="8,2"/>
        </Style>

        <Style x:Key="ElDataGridCellCenter" TargetType="DataGridCell" BasedOn="{StaticResource ElDataGridCell}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ElDataGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource ElText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ElHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ElSelected}"/>
                    <Setter Property="Foreground" Value="{StaticResource ElText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ElComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource ElText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBd" Background="Transparent" Padding="10,0" Height="24" CornerRadius="2" Margin="4,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#F5F7FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#ECF5FF"/>
                                <Setter Property="Foreground" Value="#409EFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ElSelect" TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="MaxHeight" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource ElText}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource ElInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,0,28,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ElComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Border x:Name="Bd"
                                    Background="White"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                    <Path HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          Data="M0,0 L3.5,4 L7,0"
                                          Stroke="#C0C4CC"
                                          StrokeThickness="1.4"
                                          StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <ToggleButton Opacity="0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,8">
                                    <Border Background="White"
                                            BorderBrush="#E4E7ED"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="0,6">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.12" Direction="270" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ElInputHover}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ElPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ElPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ElDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource ElText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ElBorder}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource ElBorder}"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="MinRowHeight" Value="32"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ElColumnHeader}"/>
            <Setter Property="CellStyle" Value="{StaticResource ElDataGridCell}"/>
            <Setter Property="RowStyle" Value="{StaticResource ElDataGridRow}"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="16,12,16,0" Background="#ECF5FF" BorderBrush="#D9ECFF" BorderThickness="1" CornerRadius="4" Padding="12,8">
            <TextBlock TextWrapping="Wrap" Foreground="#606266" FontSize="12" LineHeight="20">
                <Run Text="默认规则：当前用户对冲突文档任一权限没有时，默认选择"/>
                <Run Text="「采用服务器版本替换本地版本」" FontWeight="SemiBold"/>
                <Run Text="；否则默认选择"/>
                <Run Text="「采用本地版本检出并替换服务器版本」" FontWeight="SemiBold"/>
                <Run Text="。"/>
            </TextBlock>
        </Border>

        <Border Grid.Row="1" Margin="16,8,16,8" BorderBrush="#EBEEF5" BorderThickness="1" CornerRadius="4" Background="White" Padding="0">
            <Grid>
                <DataGrid x:Name="GridRows"
                          Style="{StaticResource ElDataGrid}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          SelectionChanged="OnGridSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="48" CanUserResize="False" CanUserSort="False"
                                                HeaderStyle="{StaticResource ElColumnHeaderCenter}"
                                                CellStyle="{StaticResource ElDataGridCellCenter}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected, Mode=TwoWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              PreviewMouseLeftButtonDown="OnRowCheckPreviewMouseDown"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="序号" Binding="{Binding Seq}" Width="64" IsReadOnly="True"
                                            HeaderStyle="{StaticResource ElColumnHeaderCenter}"
                                            CellStyle="{StaticResource ElDataGridCellCenter}"/>
                        <DataGridTextColumn Header="编号" Binding="{Binding DocNumber}" Width="128" IsReadOnly="True"/>
                        <DataGridTextColumn Header="名称" Binding="{Binding DocName}" Width="148" IsReadOnly="True"/>
                        <DataGridTextColumn Header="文件夹" Binding="{Binding FolderFullPath}" Width="*" MinWidth="180" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="文档读取权限" Width="128" SortMemberPath="DocRead" CanUserSort="True"
                                                HeaderStyle="{StaticResource ElColumnHeaderCenter}"
                                                CellStyle="{StaticResource ElDataGridCellCenter}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentPresenter Content="{Binding DocRead}" ContentTemplate="{StaticResource PermTagTemplate}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="文档修改权限" Width="128" SortMemberPath="DocModify" CanUserSort="True"
                                                HeaderStyle="{StaticResource ElColumnHeaderCenter}"
                                                CellStyle="{StaticResource ElDataGridCellCenter}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentPresenter Content="{Binding DocModify}" ContentTemplate="{StaticResource PermTagTemplate}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="文件夹读取权限" Width="140" SortMemberPath="FolderRead" CanUserSort="True"
                                                HeaderStyle="{StaticResource ElColumnHeaderCenter}"
                                                CellStyle="{StaticResource ElDataGridCellCenter}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentPresenter Content="{Binding FolderRead}" ContentTemplate="{StaticResource PermTagTemplate}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="文件夹修改权限" Width="140" SortMemberPath="FolderModify" CanUserSort="True"
                                                HeaderStyle="{StaticResource ElColumnHeaderCenter}"
                                                CellStyle="{StaticResource ElDataGridCellCenter}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentPresenter Content="{Binding FolderModify}" ContentTemplate="{StaticResource PermTagTemplate}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="操作" Width="360" MinWidth="280" IsReadOnly="True"
                                                SortMemberPath="Operation" CanUserSort="True"
                                                CellStyle="{StaticResource ElDataGridCellOp}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding OperationTexts}"
                                              SelectedItem="{Binding Operation, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ElSelect}"
                                              IsEditable="False"
                                              IsTextSearchEnabled="False"
                                              Margin="0"
                                              HorizontalAlignment="Stretch"
                                              PreviewMouseLeftButtonDown="OnOperationComboPreviewMouseDown"
                                              DropDownOpened="OnOperationDropDownOpened"
                                              SelectionChanged="OnOperationSelectionChanged"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border x:Name="LoadingMask"
                        Background="#CCFFFFFF"
                        Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <hc:LoadingCircle Width="40" Height="40"/>
                        <TextBlock x:Name="LoadingText"
                                   Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#909399"
                                   FontSize="13"
                                   Text="正在加载权限数据…"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="#EBEEF5" BorderThickness="0,1,0,0" Padding="16,12" Background="White">
            <Grid>
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,360,0"
                           TextWrapping="Wrap"
                           Foreground="#909399"
                           FontSize="12"
                           Text="勾选或 Ctrl / Shift 多选行后，改其中一行的操作会同步到所选行。"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ConfirmButton"
                        Content="确认使用当前界面所选操作"
                        Width="240" Height="32"
                        Style="{DynamicResource ButtonPrimary}"
                        IsEnabled="False"
                        Click="OnConfirmClick"/>
                <Button x:Name="CancelButton"
                        Content="取消"
                        Width="88" Height="32"
                        Margin="12,0,0,0"
                        Style="{DynamicResource ButtonDefault}"
                        IsCancel="True"
                        Click="OnCancelClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
