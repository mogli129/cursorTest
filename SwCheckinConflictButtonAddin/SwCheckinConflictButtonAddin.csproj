<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>SwCheckinConflictButtonAddin</RootNamespace>
    <AssemblyName>SwCheckinConflictButtonAddin</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ComVisible>false</ComVisible>
    <AssemblyTitle>检入冲突窗口按钮</AssemblyTitle>
    <Product>SwCheckinConflictButtonAddin</Product>
    <Description>在“检入文档冲突处理”窗口右上角注入自定义按钮</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup>
    <SwApiRedist Condition="Exists('C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist\SolidWorks.Interop.swpublished.dll')">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SwApiRedist>
    <SwApiRedist Condition="'$(SwApiRedist)' == '' And Exists('C:\Program Files\Dassault Systemes\SOLIDWORKS 2022\api\redist\SolidWorks.Interop.swpublished.dll')">C:\Program Files\Dassault Systemes\SOLIDWORKS 2022\api\redist</SwApiRedist>
    <SwApiRedist Condition="'$(SwApiRedist)' == '' And Exists('C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS 2022\api\redist\SolidWorks.Interop.swpublished.dll')">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS 2022\api\redist</SwApiRedist>
  </PropertyGroup>

  <Target Name="EnsureSwInterop" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(SwApiRedist)' == ''" Text="找不到 SolidWorks Interop DLL。请安装 SOLIDWORKS 2022，或在编译前设置属性 SwApiRedist 指向 api\redist 目录。" />
  </Target>

  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SwApiRedist)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SwApiRedist)\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SwApiRedist)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <None Include="SwCheckinConflictButtonAddin.dll.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
